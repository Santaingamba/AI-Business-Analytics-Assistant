# ENVIRONMENT
ENVIRONMENT=development
PROJECT_NAME="AI Business Analytics Assistant"

# POSTGRES
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=analytics_db
POSTGRES_PORT=5432

# DATABASE (Used by SQLAlchemy)
DATABASE_URL=postgresql://admin:admin@localhost:5432/analytics_db

# BACKEND
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000"]
SECRET_KEY=supersecretkeythatshouldbechangedinproduction
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# FRONTEND
VITE_API_BASE_URL=http://localhost:8000/api/v1
